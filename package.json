{
  "name": "plot-game",
  "version": "1.0.0",
  "description": "The Plot - Party Deduction Game",
  "main": "server/index.js",
  "scripts": {
    "start": "node start_fixed.js",
    "start:dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "client": "cd plot-mobile && npm start",
    "install:all": "npm install && cd server && npm install && cd ../plot-mobile && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "private": true
}
